DEPLOY_IMAGE_TAG=prod
DEPLOY_ENV_FILE=.env.prod

ACCESS_CONTROL_ENVIRONMENT=production
ACCESS_CONTROL_DATABASE_URL=postgresql+asyncpg://younilab:CHANGE_ME@younilab-postgresql:5432/access_control
ACCESS_CONTROL_JWT_PRIVATE_KEY=CHANGE_ME
ACCESS_CONTROL_JWT_PUBLIC_KEY=CHANGE_ME
ACCESS_CONTROL_JWT_ISSUER=younilab-access-control
ACCESS_CONTROL_JWT_AUDIENCE=younilab-seo
ACCESS_CONTROL_ACCESS_TOKEN_MINUTES=10
ACCESS_CONTROL_REFRESH_TOKEN_DAYS=30
ACCESS_CONTROL_PORTAL_URL=https://example.com
ACCESS_CONTROL_NOTIFICATION_ENCRYPTION_KEY=CHANGE_ME

RESOURCE_CATALOG_ENVIRONMENT=production
RESOURCE_CATALOG_DATABASE_URL=postgresql+asyncpg://younilab:CHANGE_ME@younilab-postgresql:5432/resource_catalog
RESOURCE_CATALOG_ACCESS_CONTROL_URL=http://access-control-api:8000

GEO_ANALYSIS_DATABASE_URL=postgresql+asyncpg://younilab:CHANGE_ME@younilab-postgresql:5432/geo_analysis
RABBITMQ_DEFAULT_USER=geo_worker
RABBITMQ_DEFAULT_PASS=CHANGE_ME
GEO_ANALYSIS_PUBLISHER_BACKEND=rabbitmq
GEO_ANALYSIS_RABBITMQ_URL=amqp://geo_worker:CHANGE_ME@rabbitmq:5672/
GEO_ANALYSIS_RABBITMQ_EXCHANGE=geo.query-runs
GEO_ANALYSIS_RABBITMQ_QUEUE_PREFIX=geo.query-runs
GEO_ANALYSIS_RABBITMQ_ROUTING_KEY_PREFIX=geo.query-runs
GEO_ANALYSIS_CALLBACK_BASE_URL=http://geo-analysis-api:8002
GEO_ANALYSIS_WORKER_PROVIDER=gemini
GEO_ANALYSIS_WORKER_QUEUE=geo.query-runs.gemini
GEO_ANALYSIS_WORKER_PREFETCH=1
GEO_TRACKING_BASE_URL=http://geo-tracking-api:8003
GEO_TRACKING_TIMEOUT_SECONDS=60

GCP_CREDENTIALS_FILE_HOST=/root/kmind/deploy/credentials/prod-gcp-key.json
GOOGLE_APPLICATION_CREDENTIALS=/app/config/gcp-key.json
VERTEX_AI_LOCATION=global
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TEMPERATURE=1.0
GEMINI_THINKING_LEVEL=medium
SERPAPI_API_KEY=CHANGE_ME
SERPAPI_TIMEOUT_SECONDS=30
